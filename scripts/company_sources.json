  {
    "name": "Google",
    "source_type": "html_list",
    "source_tier": 5,
    "careers_url": "https://www.google.com/about/careers/applications/jobs/results?category=USER_EXPERIENCE&category=MARKETING&q=designer&location=India",
    "allow_zero_results": false,
    "note": "robots.txt forbids ?page= on results for all crawlers (the full ban is Yandex-only). One page only; a full page fails loudly.",
    "config": {
      "listUrl": "https://www.google.com/about/careers/applications/jobs/results?category=USER_EXPERIENCE&category=MARKETING&q=designer&location=India",
      "singlePage": true,
      "pageSize": 20,
      "itemSelector": "li[ssk]",
      "listContainerSelector": "h3:-soup-contains(\"Sort by\")",
      "fields": {
        "external_job_id": {
          "selector": "a[href*=\"jobs/results/\"]",
          "attr": "href",
          "pattern": "results/(\\d+)-"
        },
        "title": {
          "selector": "h3",
          "text": true
        },
        "job_url": {
          "selector": "a[href*=\"jobs/results/\"]",
          "attr": "href",
          "base": "https://www.google.com/about/careers/applications/"
        },
        "location": {
          "selector": "span.r0wTof",
          "text": true
        }
      }
    }
  },
