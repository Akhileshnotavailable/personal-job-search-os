[
  {
    "name": "Akamai",
    "source_type": "json_api",
    "source_tier": 3,
    "careers_url": "https://akamai.dejobs.org/",
    "allow_zero_results": false,
    "note": "akamai.com denies everything; Akamai syndicates every job to DirectEmployers, whose robots.txt allows crawling.",
    "config": {
      "listUrl": "https://prod-search-api.jobsyn.org/api/v1/solr/search?location=India&page={page}",
      "headers": {
        "Accept": "application/json",
        "x-origin": "akamai.dejobs.org"
      },
      "jobsPath": "jobs",
      "totalPath": "pagination.total",
      "pageSize": 10,
      "startPage": 1,
      "maxPages": 20,
      "fields": {
        "external_job_id": "guid",
        "title": "title_exact",
        "job_url": {
          "template": "https://akamai.dejobs.org/{location_exact|slug}/{title_slug}/{guid}/job/"
        },
        "location": "location_exact",
        "description": "description",
        "posted_at": "date_new"
      }
    }
  },
  {
    "name": "Apple",
    "source_type": "html_list",
    "source_tier": 5,
    "careers_url": "https://jobs.apple.com/en-in/search?location=india-INDC",
    "allow_zero_results": false,
    "note": "Server-rendered search, scoped to India. Id is requisition-location, so one role in two cities is two rows.",
    "config": {
      "listUrl": "https://jobs.apple.com/en-in/search?location=india-INDC&page={page}",
      "itemSelector": "div.job-title.job-list-item",
      "pageSize": 20,
      "startPage": 1,
      "maxPages": 30,
      "fields": {
        "external_job_id": {
          "selector": "h3 a",
          "attr": "href",
          "pattern": "/details/([^/?#]+)"
        },
        "title": {
          "selector": "h3 a",
          "text": true
        },
        "job_url": {
          "selector": "h3 a",
          "attr": "href",
          "base": "https://jobs.apple.com"
        },
        "location": {
          "selector": ".job-title-location span:not(.a11y)",
          "text": true
        },
        "department": {
          "selector": "span.team-name",
          "text": true
        },
        "posted_at": {
          "selector": "span.job-posted-date",
          "text": true
        }
      }
    }
  },
